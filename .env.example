# Copy to .env and fill in. Never commit real values. See docs/07-operations-runbook.md.

# --- WhatsApp Business Cloud API (Meta developer dashboard) ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v21.0

# --- Database (Postgres / Supabase). Omit to run in-memory without pilot features. ---
DATABASE_URL=
# Optional house account used when no territory matches
DEFAULT_CLIENT_ID=
# 1 = only route to installers with prepaid credit (default). 0 during free-visit pilots.
REQUIRE_PREPAID=1

# --- Agent ---
# water (default) | solar
PLAYBOOK=water
BRAND_NAME=
PRIVACY_URL=
# Gazetted ad-hoc public holidays, comma-separated YYYY-MM-DD
EXTRA_HOLIDAYS=

# --- LLM fallback (on when ANTHROPIC_API_KEY is set; LLM_FALLBACK=0 turns it off) ---
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_FALLBACK=1

# --- Payments (prepaid top-ups). Webhook URL: https://<host>/paystack/webhook ---
PAYSTACK_SECRET_KEY=

# --- Meta: ad-set pause/resume + Conversions API for Business Messaging ---
META_ACCESS_TOKEN=
META_DATASET_ID=
# META_API_VERSION=v21.0

PORT=3000
