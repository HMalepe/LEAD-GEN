# Copy to .env and fill in. Never commit real values.

# WhatsApp Business Cloud API (Meta developer dashboard)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0

# Postgres / Supabase. Omit to run in-memory.
DATABASE_URL=
# Client UUID used when no territory row matches the lead's postal code
DEFAULT_CLIENT_ID=

# Consumer-facing identity
BRAND_NAME=
PRIVACY_URL=

# Gazetted ad-hoc public holidays, comma-separated YYYY-MM-DD
EXTRA_HOLIDAYS=

PORT=3000
